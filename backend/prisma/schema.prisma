generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String            @id @default(uuid())
  name         String?
  email        String            @unique
  passwordHash String
  createdAt    DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  onboardingStatus Json?             // Stores { dashboard: boolean, context: boolean, campaigns: boolean }
  activityLogs     ActivityLog[]
  workspaces   Workspace[]       @relation("UserWorkspaces")
  memberships  WorkspaceMember[]
}

model Workspace {
  id              String            @id @default(uuid())
  ownerId         String
  name            String
  businessContext String?
  competitors     Json?
  planTier        PlanTier          @default(FREE)
  createdAt       DateTime          @default(now())
  activityLogs    ActivityLog[]
  campaigns       Campaign[]
  documents       Document[]
  owner           User              @relation("UserWorkspaces", fields: [ownerId], references: [id])
  members         WorkspaceMember[]
  isEarlyAdopter  Boolean           @default(false)
  earlyAdopterJoinedAt DateTime?
  lastAnalysisSummary String?       // Stores the summary of the last completed analysis batch
  gapAnalysis     Json?             // Stores the latest gap analysis result
  integrations    Json?             // Stores webhook URLs and notification settings
  chatHistory     Json?             // Stores the conversation history with Geniy
  domains         Domain[]
  subscription    Subscription?
  transactions    Transaction[]
}

model Subscription {
  id                       String    @id @default(uuid())
  workspaceId              String    @unique
  planTier                 PlanTier
  status                   String    // active, trialing, past_due, canceled
  paystackSubscriptionCode String?
  paystackEmailToken       String?
  currentPeriodStart       DateTime
  currentPeriodEnd         DateTime
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  workspace                Workspace @relation(fields: [workspaceId], references: [id])
}

model Transaction {
  id          String    @id @default(uuid())
  workspaceId String
  amount      Float
  currency    String    @default("GHS")
  status      String    // success, failed, pending
  reference   String    @unique // Paystack reference
  planTier    PlanTier
  metadata    Json?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
}

model Domain {
  id          String   @id @default(uuid())
  domain      String   @unique
  workspaceId String
  status      String   @default("pending") // pending, active, error
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
}

model Document {
  id          String    @id @default(uuid())
  workspaceId String
  name        String
  type        String
  size        Int
  url         String?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
}

model WorkspaceMember {
  id          String     @id @default(uuid())
  workspaceId String
  userId      String
  role        MemberRole @default(EDITOR)
  user        User       @relation(fields: [userId], references: [id])
  workspace   Workspace  @relation(fields: [workspaceId], references: [id])

  @@unique([workspaceId, userId])
}

model Campaign {
  id           String        @id @default(uuid())
  workspaceId  String
  name         String
  description  String?
  isDeleted    Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  insights     AIInsight[]
  activityLogs ActivityLog[]
  workspace    Workspace     @relation(fields: [workspaceId], references: [id])
  surveys      Survey[]
}

model Survey {
  id           String        @id @default(uuid())
  campaignId   String
  title        String
  jsonSchema   Json
  themeConfig  Json?
  isPublished  Boolean       @default(false)
  publicSlug   String        @unique
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  insights     AIInsight[]
  activityLogs ActivityLog[]
  responses    Response[]
  campaign     Campaign      @relation(fields: [campaignId], references: [id])
}

model Response {
  id          String   @id @default(uuid())
  surveyId    String
  rawAnswers  Json
  metadata    Json?
  submittedAt DateTime @default(now())
  survey      Survey   @relation(fields: [surveyId], references: [id])
}

model AIInsight {
  id          String      @id @default(uuid())
  campaignId  String
  surveyId    String?
  insightType InsightType
  content     Json
  modelUsed   String
  tokenUsage  Json?
  createdAt   DateTime    @default(now())
  campaign    Campaign    @relation(fields: [campaignId], references: [id])
  survey      Survey?     @relation(fields: [surveyId], references: [id])
}

model ActivityLog {
  id          String     @id @default(uuid())
  workspaceId String?
  campaignId  String?
  surveyId    String?
  userId      String?
  action      String
  metadata    Json?
  createdAt   DateTime   @default(now())
  campaign    Campaign?  @relation(fields: [campaignId], references: [id])
  survey      Survey?    @relation(fields: [surveyId], references: [id])
  user        User?      @relation(fields: [userId], references: [id])
  workspace   Workspace? @relation(fields: [workspaceId], references: [id])
}

enum PlanTier {
  FREE
  STARTER
  PRO
  BUSINESS
  ENTERPRISE
}

enum MemberRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum InsightType {
  SUMMARY
  SENTIMENT
  TREND
  RECOMMENDATION
}
